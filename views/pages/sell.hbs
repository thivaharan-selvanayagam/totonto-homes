  </div>
</section>

<script>
document.getElementById('valuationForm')?.addEventListener('submit', function(e) {
  e.preventDefault();
  this.innerHTML = '<div class="form-success"><i class="fas fa-check-circle"></i><h3>Thank you!</h3><p>John will contact you within 24 hours with your free home valuation.</p></div>';
});
