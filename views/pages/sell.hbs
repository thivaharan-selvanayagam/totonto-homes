      <div class="sell-form-col">
        <div class="sell-form-card">
          <h3>Get a Free Home Valuation</h3>
          <p>Find out what your home is worth in today's market.</p>
          <form id="valuationForm">
            <input type="text" name="address" placeholder="Property Address" required />
            <input type="text" name="city" placeholder="City" required />
            <input type="text" name="zip" placeholder="ZIP Code" required />
            <select name="propertyType">
              <option value="">Property Type</option>
              <option value="single-family">Single Family</option>
              <option value="condo">Condo/Townhouse</option>
              <option value="multi-family">Multi-Family</option>
              <option value="land">Land</option>
            </select>
            <input type="text" name="name" placeholder="Your Name" required />
            <input type="tel" name="phone" placeholder="Phone Number" required />
            <input type="email" name="email" placeholder="Email Address" required />
            <button type="submit" class="btn btn-primary btn-full">Get My Free Valuation</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section selling-process bg-light">
