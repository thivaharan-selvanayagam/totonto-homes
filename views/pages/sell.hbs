<section class="section mortgage-section">
  <div class="container">
    <div class="section-header centered">
      <div class="section-eyebrow">Planning Tools</div>
      <h2>Mortgage Calculator</h2>
      <p>Estimate your monthly payment based on purchase price, down payment, and interest rate.</p>
    </div>
    <div class="mortgage-calc-wrap">
      <div class="calculator-card">
        <div class="calc-inputs" id="mortgageCalc">
          <div class="form-group">
            <label>Home Price ($)</label>
            <input type="number" id="calcPrice" placeholder="600000" value="600000" />
          </div>
          <div class="form-group">
            <label>Down Payment (%)</label>
            <input type="number" id="calcDown" placeholder="20" value="20" min="0" max="100" />
          </div>
          <div class="form-group">
            <label>Interest Rate (%)</label>
            <input type="number" id="calcRate" placeholder="6.75" value="6.75" step="0.01" />
          </div>
          <div class="form-group">
            <label>Loan Term</label>
            <select id="calcTerm">
              <option value="30" selected>30 Years</option>
              <option value="20">20 Years</option>
              <option value="15">15 Years</option>
              <option value="10">10 Years</option>
            </select>
          </div>
        </div>
        <div class="calc-result" id="calcResult">
          <div class="monthly">$3,107/mo</div>
          <div class="monthly-label">Estimated Monthly Payment</div>
        </div>
        <p style="font-size:0.75rem;color:#999;margin-top:12px;text-align:center;">* Estimate only. Does not include taxes, insurance, or HOA fees. Contact Toronto Homes for a full pre-approval.</p>
      </div>
    </div>
  </div>
</section>
