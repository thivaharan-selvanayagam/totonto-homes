<!-- FEATURED PORTFOLIO -->
<section class="section portfolio-section">
  <div class="container">
    <div class="section-header centered">
      <div class="section-eyebrow">Properties</div>
      <h2>My Portfolio</h2>
    </div>

    <div class="portfolio-filters">
      <div class="filter-row">
        <input type="text" id="portfolioSearch" placeholder="Search by address..." class="filter-input" />
        <select id="portfolioSort" class="filter-select-sm">
          <option value="createdOnDesc">Newest</option>
          <option value="listPriceDesc">Price (High→Low)</option>
          <option value="listPriceAsc">Price (Low→High)</option>
        </select>
      </div>
      <div class="filter-row">
        <select id="portfolioBeds" class="filter-select-sm"><option value="">Beds</option><option value="1">1+</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option></select>
        <select id="portfolioMinPrice" class="filter-select-sm"><option value="">Min Price</option><option value="200000">$200K</option><option value="500000">$500K</option><option value="800000">$800K</option><option value="1000000">$1M</option></select>
        <select id="portfolioMaxPrice" class="filter-select-sm"><option value="">Max Price</option><option value="500000">$500K</option><option value="800000">$800K</option><option value="1000000">$1M</option><option value="2000000">$2M+</option></select>
        <select id="portfolioStatus" class="filter-select-sm"><option value="A">Active</option><option value="U">Sold</option></select>
      </div>
    </div>

    <div class="listings-grid" id="portfolioGrid">
      {{#each featuredListings}}
        {{> listing-card}}
      {{else}}
        <div class="no-listings">
          <i class="fas fa-home"></i>
          <p>Loading properties from Repliers API...</p>
        </div>
      {{/each}}
    </div>

    <div class="section-cta">
      <a href="/listings" class="btn btn-primary">View All Listings</a>
    </div>
  </div>
</section>

