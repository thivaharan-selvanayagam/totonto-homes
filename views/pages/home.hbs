<!-- HERO -->
<section class="hero">
  <div class="hero-bg">
    <div class="hero-overlay"></div>
    <div class="hero-image" style="background-image: url('https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=1600&q=85')"></div>
  </div>
  <div class="hero-content">
    <div class="container">
      <div class="hero-text">
        {{!-- <div class="hero-eyebrow">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 0L10 6H16L11 9.5L13 16L8 12L3 16L5 9.5L0 6H6L8 0Z" fill="#c9a96e"/></svg>
          Real Estate Services in Torronto
        </div> --}}
        <h1>Discover<br><em>Luxury Living</em></h1>
        <p>Find your perfect home in Placer County and throughout Toronto with Rajivan Varatharajah, your trusted real estate professional.</p>
      </div>

      <div class="hero-search">
        <div class="search-tabs">
          <button class="search-tab active" data-tab="buy">Buy</button>
          <button class="search-tab" data-tab="sell">Sell</button>
          <button class="search-tab" data-tab="rent">Rent</button>
        </div>
        <form class="search-form" action="/listings" method="GET">
          <div class="search-input-wrap">
            <i class="fas fa-search"></i>
            <input type="text" name="search" id="heroSearch" placeholder="Search by city, neighborhood, or address..." autocomplete="off" />
            <div class="search-autocomplete" id="heroAutocomplete"></div>
          </div>
          <div class="search-filters-row">
            <select name="type" class="filter-select">
              <option value="">Property Type</option>
              <option value="detached">Detached</option>
              <option value="semi-detached">Semi-Detached</option>
              <option value="condo">Condo</option>
              <option value="townhouse">Townhouse</option>
            </select>
            <select name="beds" class="filter-select">
              <option value="">Bedrooms</option>
              <option value="1">1+</option>
              <option value="2">2+</option>
              <option value="3">3+</option>
              <option value="4">4+</option>
              <option value="5">5+</option>
            </select>
            <select name="minPrice" class="filter-select">
              <option value="">Min Price</option>
              <option value="200000">$200K</option>
              <option value="400000">$400K</option>
              <option value="600000">$600K</option>
              <option value="800000">$800K</option>
              <option value="1000000">$1M</option>
            </select>
            <select name="maxPrice" class="filter-select">
              <option value="">Max Price</option>
              <option value="400000">$400K</option>
              <option value="600000">$600K</option>
              <option value="800000">$800K</option>
              <option value="1000000">$1M</option>
              <option value="2000000">$2M+</option>
            </select>
            <button type="submit" class="search-btn">
              <i class="fas fa-search"></i> Search
            </button>
          </div>
        </form>
      </div>

      {{!-- <div class="hero-stats">
        <div class="stat"><strong>500+</strong><span>Homes Sold</span></div>
        <div class="stat"><strong>20+</strong><span>Years Experience</span></div>
        <div class="stat"><strong>$250M+</strong><span>In Transactions</span></div>
        <div class="stat"><strong>98%</strong><span>Client Satisfaction</span></div>
      </div> --}}
    </div>
  </div>
</section>

