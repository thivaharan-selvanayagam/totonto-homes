<section class="page-hero page-hero-sm">
  <div class="page-hero-bg" style="background-image: url('https://images.unsplash.com/photo-1600585154526-990dced4db0d?w=1400&q=80')"></div>
  <div class="page-hero-overlay"></div>
  <div class="container">
    <div class="page-hero-content">
      <div class="breadcrumb"><a href="/">Home</a> <span>/</span> Contact</div>
      <h1>Let's Connect</h1>
      <p>Ready to start your real estate journey? Toronto Homes is here to help.</p>
    </div>
  </div>
</section>

<section class="section contact-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info-col">
        <div class="section-eyebrow">Get In Touch</div>
        <h2>How Can Toronto Homes Help You?</h2>
        <p>Whether you're buying your first home, selling a property, or looking for investment opportunities, Toronto Homes is ready to guide you every step of the way.</p>

        <div class="contact-methods">
          <div class="contact-method">
            <div class="cm-icon"><i class="fas fa-phone"></i></div>
            <div class="cm-info">
              <h4>Call or Text</h4>
              <a href="tel:+15551234567">(555) 123-4567</a>
            </div>
          </div>
          <div class="contact-method">
            <div class="cm-icon"><i class="fas fa-envelope"></i></div>
            <div class="cm-info">
              <h4>Email</h4>
              <a href="mailto:contact@torontohomes.com">contact@torontohomes.com</a>
            </div>
          </div>
          <div class="contact-method">
            <div class="cm-icon"><i class="fas fa-map-marker-alt"></i></div>
            <div class="cm-info">
              <h4>Office</h4>
              <p>121 Bloor St E Suite 410,<br>Toronto, ON M4W 3M5</p>
            </div>
          </div>
          <div class="contact-method">
            <div class="cm-icon"><i class="fas fa-clock"></i></div>
            <div class="cm-info">
              <h4>Office Hours</h4>
              <p>Mon – Sat: 8am – 7pm<br>Sun: By Appointment</p>
            </div>
          </div>
        </div>

        <div class="contact-social">
          <h4>Follow Marco</h4>
          <div class="social-links">
            <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
            <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
            <a href="#" class="social-link"><i class="fab fa-linkedin-in"></i></a>
            <a href="#" class="social-link"><i class="fab fa-youtube"></i></a>
          </div>
        </div>
      </div>

      <div class="contact-form-col">
        <div class="contact-form-card">
          <h3>Send a Message</h3>
          <form id="contactForm">
            <div class="form-row-2">
              <div class="form-group">
                <label>First Name</label>
                <input type="text" name="firstName" placeholder="John" required />
              </div>
              <div class="form-group">
                <label>Last Name</label>
                <input type="text" name="lastName" placeholder="Doe" required />
              </div>
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" placeholder="john@example.com" required />
            </div>
            <div class="form-group">
              <label>Phone Number</label>
              <input type="tel" name="phone" placeholder="(555) 000-0000" />
            </div>
            <div class="form-group">
              <label>I'm Looking To</label>
              <select name="intent">
                <option value="buy">Buy a Home</option>
                <option value="sell">Sell a Home</option>
                <option value="invest">Invest in Real Estate</option>
                <option value="other">Just Browsing / Other</option>
              </select>
            </div>
            <div class="form-group">
              <label>Message</label>
              <textarea name="message" rows="5" placeholder="Tell Toronto Homes what you're looking for..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-full">
              <i class="fas fa-paper-plane"></i> Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.getElementById('contactForm')?.addEventListener('submit', function(e) {
  e.preventDefault();
  this.innerHTML = '<div class="form-success"><i class="fas fa-check-circle"></i><h3>Message Sent!</h3><p>Thank you for reaching out. Toronto Homeswill contact you within 24 hours.</p></div>';
});
</script>
